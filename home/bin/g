#!/bin/bash

# Quickly search source code
# Examples
# - g "foo"
# - g -x "bar" "foo"

# Notes
# - This uses 'ripgrep' if it is available
# - This ignores a number of files that should be excluded normally

# Standard exclusions
EXCLUDED_DIRS=(
    .venv
    .git
    .terragrunt-cache
    .claude
    ansible_collections
)
EXCLUDED_EXTENSIONS=(
    pdf jpg jpeg png
    zip tar gz
    exe bin
    mp4 mp3
)

run_grep() {
    local exclude_pattern=""
    local args=()

    # Simple argument parser
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -x)
                exclude_pattern="$2"
                shift 2
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done

    local dir ext
    local excludes=()

    if command -v rg &>/dev/null; then
        # ripgrep uses -g for glob patterns; a leading ! excludes.
        for dir in "${EXCLUDED_DIRS[@]}"; do excludes+=(-g "!${dir}"); done
        for ext in "${EXCLUDED_EXTENSIONS[@]}"; do excludes+=(-g "!*.${ext}"); done
        # *{pattern}* ensures it matches anywhere in the path.
        [[ -n "$exclude_pattern" ]] && excludes+=(-g "!*${exclude_pattern}*")

        rg -uu "${excludes[@]}" --color=always "${args[@]}"
    else
        for dir in "${EXCLUDED_DIRS[@]}"; do excludes+=(--exclude-dir="${dir}"); done
        for ext in "${EXCLUDED_EXTENSIONS[@]}"; do excludes+=(--exclude="*.${ext}"); done
        [[ -n "$exclude_pattern" ]] && excludes+=(--exclude-dir="*${exclude_pattern}*" --exclude="*${exclude_pattern}*")

        grep -r "${excludes[@]}" --color=always "${args[@]}"
    fi
}

clear
run_grep "$@"
